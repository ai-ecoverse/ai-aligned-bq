bytes_to_usd() {
    awk -v b="$1" -v p="$BQ_PRICE_PER_TIB" 'BEGIN { printf "%.4f", (b / (2 ^ 40)) * p }'
}

bytes_human() {
    awk -v b="$1" 'BEGIN {
        if (b >= 2 ^ 40) printf "%.2f TiB", b / (2 ^ 40);
        else if (b >= 2 ^ 30) printf "%.2f GiB", b / (2 ^ 30);
        else if (b >= 2 ^ 20) printf "%.2f MiB", b / (2 ^ 20);
        else printf "%d B", b;
    }'
}

ledger_file() {
    echo "$BQ_STATE_DIR/spend-$(date +%Y-%m-%d).tsv"
}

ledger_today_total() {
    local f
    f=$(ledger_file)
    if [ ! -f "$f" ]; then
        echo "0"
        return
    fi
    awk -F'\t' '{ s += $4 } END { printf "%.4f", s + 0 }' "$f"
}

ledger_record() {
    local bytes="$1" usd="$2" tool="$3"
    mkdir -p "$BQ_STATE_DIR"
    printf '%s\t%s\t%s\t%s\n' "$(date +%H:%M:%S)" "$tool" "$bytes" "$usd" >> "$(ledger_file)"
}

# awk-based float comparison: prints 1 if a > b, else 0
gt() {
    awk -v a="$1" -v b="$2" 'BEGIN { print (a > b) ? 1 : 0 }'
}

# ---------------------------------------------------------------------------
# Locate the bq subcommand (first non-flag token, skipping global flags)
# ---------------------------------------------------------------------------
args=("$@")
sub_index=-1
skip_next=false
idx=0
for arg in "$@"; do
    if [ "$skip_next" = true ]; then
        skip_next=false
        idx=$((idx + 1))
        continue
    fi
    case "$arg" in
        --*=*)
            ;;  # global flag with inline value, e.g. --project_id=foo
        --project_id|--location|--format|--api|--api_version|--dataset_id|--job_id|--bigqueryrc|--httplib2_debuglevel|--trace|--max_rows_per_request)
            skip_next=true ;;  # global flag whose value is the next token
        --*|-*)
            ;;  # boolean global flag, e.g. --quiet, --headless, --sync
        *)
            sub_index=$idx
            break ;;
    esac
    idx=$((idx + 1))
done

ai_tool=$(detect_ai_tool)

# Determine the subcommand string (if any)
subcommand=""
if [ "$sub_index" -ge 0 ]; then
    subcommand="${args[$sub_index]}"
fi

# Pass through unless this is an AI-driven `query` that actually runs.
if [ "$subcommand" != "query" ] || [ "$ai_tool" = "none" ]; then
    exec "$BQ_BIN" "$@"
fi

# A dry run costs nothing and is exactly what we want to encourage: let it pass.
for arg in "$@"; do
    case "$arg" in
        --dry_run|--dry_run=true|--dry-run)
            exec "$BQ_BIN" "$@" ;;
    esac
done

# Split into global args (before subcommand) and query args (after subcommand).
global_args=()
if [ "$sub_index" -gt 0 ]; then
    global_args=("${args[@]:0:$sub_index}")
fi
query_args=("${args[@]:$((sub_index + 1))}")

# Inspect query args: detect the budget-burner override and a user-set cap,
# and strip the override flag (bq does not understand it).
override=false
user_has_max_bytes=false
clean_query_args=()
for arg in "${query_args[@]}"; do
    case "$arg" in
        --"${ai_tool}"-is-a-budget-burner)
            override=true
            continue ;;
        --maximum_bytes_billed=*|--maximum_bytes_billed)
            user_has_max_bytes=true ;;
    esac
    clean_query_args+=("$arg")
done

# ---------------------------------------------------------------------------
# Mandatory dry run: estimate bytes for free before spending a cent.
# ---------------------------------------------------------------------------
echo "[ai-aligned-bq] $ai_tool detected — running a mandatory dry run to estimate cost..." >&2
dry_out=$("$BQ_BIN" "${global_args[@]}" query --dry_run "${clean_query_args[@]}" 2>&1)
dry_status=$?

if [ "$dry_status" -ne 0 ]; then
    echo "[ai-aligned-bq] Dry run failed; refusing to run the real query." >&2
    echo "$dry_out" >&2
    exit "$dry_status"
fi

bytes=$(printf '%s\n' "$dry_out" | grep -oE '[0-9]+ bytes of data' | grep -oE '[0-9]+' | head -1)
if [ -z "$bytes" ]; then
    echo "[ai-aligned-bq] Could not parse a byte estimate from the dry run; refusing to run." >&2
    echo "$dry_out" >&2
    exit 1
fi

usd=$(bytes_to_usd "$bytes")
today=$(ledger_today_total)
projected=$(awk -v a="$today" -v b="$usd" 'BEGIN { printf "%.4f", a + b }')

echo "[ai-aligned-bq] Estimated scan: $(bytes_human "$bytes") (~\$$usd at \$$BQ_PRICE_PER_TIB/TiB)" >&2
echo "[ai-aligned-bq] Spent so far today: \$$today / \$$BQ_DAILY_USD  →  after this query: \$$projected" >&2

# --- Per-query byte cap ---------------------------------------------------
if [ "$bytes" -gt "$BQ_MAX_BYTES" ] && [ "$override" = false ]; then
    echo "" >&2
    echo "Error: '$ai_tool' wants to scan $(bytes_human "$bytes"), exceeding the per-query cap of $(bytes_human "$BQ_MAX_BYTES")." >&2
    echo "This is how a \$600 bill happens. Add a WHERE clause on the partition column," >&2
    echo "select only the columns you need (never SELECT *), and remember LIMIT does NOT reduce bytes scanned." >&2
    echo "" >&2
    echo "If you really mean it, append the flag: --${ai_tool}-is-a-budget-burner" >&2
    echo "This disables the per-query cap (the daily budget still applies) and records you as the one who lit the money on fire." >&2
    exit 1
fi

# --- Daily spend cap ------------------------------------------------------
if [ "$(gt "$projected" "$BQ_DAILY_USD")" = "1" ]; then
    echo "" >&2
    echo "Error: This query (~\$$usd) would push today's spend to \$$projected, over the \$$BQ_DAILY_USD daily budget for agents." >&2
    echo "The daily budget is a hard wall and cannot be overridden by a flag." >&2
    echo "Either wait until tomorrow, narrow the query, or have a human raise AI_ALIGNED_BQ_DAILY_USD." >&2
    echo "Today's ledger: $(ledger_file)" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Cleared. Record the estimate and run the real query with a hard backstop.
# ---------------------------------------------------------------------------
ledger_record "$bytes" "$usd" "$ai_tool"

real_extra=()
if [ "$override" = false ] && [ "$user_has_max_bytes" = false ]; then
    # Hard backstop so the actual job can never bill more than the cap,
    # even if the estimate were somehow wrong.
    real_extra=(--maximum_bytes_billed="$BQ_MAX_BYTES")
fi

if [ "$override" = true ]; then
    echo "[ai-aligned-bq] 🔥 $ai_tool invoked --${ai_tool}-is-a-budget-burner. Per-query cap disabled. The money fire is on you." >&2
fi

exec "$BQ_BIN" "${global_args[@]}" query "${real_extra[@]}" "${clean_query_args[@]}"
