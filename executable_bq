# Find the real bq executable
find_real_bq() {
    # Explicit override (useful for nonstandard installs and for testing)
    if [ -n "${AI_ALIGNED_BQ_BIN:-}" ] && [ -x "${AI_ALIGNED_BQ_BIN}" ]; then
        echo "$AI_ALIGNED_BQ_BIN"
        return
    fi

    # Common locations for the gcloud bq CLI
    local bq_paths=(
        "/usr/local/bin/bq"
        "/opt/homebrew/bin/bq"
        "/opt/homebrew/share/google-cloud-sdk/bin/bq"
        "/usr/lib/google-cloud-sdk/bin/bq"
        "/usr/local/share/google-cloud-sdk/bin/bq"
        "/snap/bin/bq"
    )

    local our_dir
    our_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd)

    for bq_path in "${bq_paths[@]}"; do
        if [ -x "$bq_path" ]; then
            echo "$bq_path"
            return
        fi
    done

    # Search PATH, skipping our own directory so we don't recurse into ourselves
    local IFS=:
    for dir in $PATH; do
        local resolved
        resolved=$(cd "$dir" 2>/dev/null && pwd)
        if [ -n "$resolved" ] && [ "$resolved" != "$our_dir" ] && [ -x "$dir/bq" ]; then
            echo "$dir/bq"
            return
        fi
    done

    echo "bq not found" >&2
    exit 1
}

BQ_BIN=$(find_real_bq)

